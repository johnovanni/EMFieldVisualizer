<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>EMFieldVisualizer</RootNamespace>
    <AssemblyName>EMFieldVisualizer</AssemblyName>
    <ApplicationIcon>Assets\EMFieldVisualizer.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\EMFieldVisualizer.ico" />
  </ItemGroup>

</Project>
